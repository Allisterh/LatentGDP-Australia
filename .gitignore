# Large fit objects (regenerable from data + Stan code)
output/fit_*.rds
output/loos*.rds
output/loo_compare.rds
# PSIS-LFO checkpoints (regenerable by R/03_compare.R; the tables in output/tables are kept),
# including the local-only superseded checkpoints in output/lfo/superseded/
output/lfo/**/*.rds
# Non-default-sample research runs (R/sample_window.R; LATENTGDP_OUT=output/sample_<x>,
# e.g. output/sample_1980/): their fit objects and LFO / particle-check checkpoints are
# regenerable and too large for git (several exceed GitHub's 100 MB limit). Their tables,
# logs, figures and driver scripts are kept.
output/sample_*/**/*.rds

# Raw ABS downloads (refetched each run)
data/raw/
data/processed/*.rds

# Stan compilation artefacts
stan/*.exe
stan/m1_baseline
stan/m2_ar1
stan/m3_corr
stan/m4_sv
stan/m5_serial
stan/m6_structural_corr
stan/m7_covid_scale
stan/m8_labour
stan/m9_struct_sv
stan/m10_labour_sv
stan/m11_mixed_freq
stan/m12_struct_sv_serial
stan/m13_serial_latent_sv

# R/RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# macOS
.DS_Store

# Claude Code working directory (not part of the project)
.claude/
output/sample_rdp/**/*.rds
output/ppc/**/*.rds

# Research variant of m13 with tighter priors (compiled executable)
stan/m13_tight_priors
